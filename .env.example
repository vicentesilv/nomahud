# Base de datos
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_NAME=nomadhud

# Autenticacion
JWT_SECRET=changeme-min-32-chars
JWT_EXPIRES_IN=24h

# Frontend y correo
# En Railway, sustituir por el dominio final de Netlify, por ejemplo:
# FRONTEND_URL=https://tu-sitio.netlify.app
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@nomahud.com
BREVO_API_KEY=
VITE_API_URL=http://localhost:3001

# Google OAuth (Google Cloud Console > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En produccion: https://nomahudapi.up.railway.app/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
